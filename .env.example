# =====================================================================
# variant.agr.br — variaveis de ambiente (exemplo, SEM valores reais)
# Copie para .env e preencha. Nunca commitar o .env real.
# =====================================================================

# ----- Aplicacao -----
NODE_ENV=development
APP_PORT=3000
# Prefixo das rotas publicas versionadas (ex.: /api/v1)
APP_API_PREFIX=/api/v1

# ----- Banco de dados (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=variant
DB_USER=variant_user
DB_PASSWORD=
# Habilita logging das queries do Sequelize (true/false)
DB_LOGGING=false
# Habilita SSL na conexao (necessario em alguns provedores gerenciados)
DB_SSL=false

# ----- Autenticacao (JWT) -----
# Segredo usado para assinar os tokens. Gere um valor longo e aleatorio.
JWT_SECRET=
# Validade do ACCESS token (formato jsonwebtoken: 15m, 1h, 3600, etc.)
JWT_ACCESS_EXPIRES_IN=15m
# Validade do REFRESH token, em dias.
REFRESH_TOKEN_EXPIRES_DAYS=30
# Custo (rounds) do bcrypt no hash de senhas.
BCRYPT_SALT_ROUNDS=10

# ----- Uploads (planilhas, KML, fotos de eventos) -----
# Diretorio de armazenamento das fotos (relativo a raiz do pacote por padrao).
UPLOAD_DIR=uploads
# Tamanho maximo de upload, em MB.
MAX_UPLOAD_MB=10
# URL publica base para montar o link das fotos (vazio = caminho relativo).
APP_PUBLIC_URL=
